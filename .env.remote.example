AGENT_WORKSPACE_IMAGE=xuping/agent-workspace:ubuntu-xfce
AGENT_WORKSPACE_DATA=./webtop-data
AGENT_WORKSPACE_USER=agent
AGENT_WORKSPACE_PASSWORD=replace-with-a-long-random-password
AGENT_WORKSPACE_AGENT=codex
DESKTOP_PORT=3001
CODE_SERVER_PORT=8443
TZ=Asia/Shanghai

# Optional: join a tailnet automatically at first boot (installs Tailscale in
# userspace mode). Prefer a one-off, pre-approved, tagged auth key, or mount it
# as a file and point TAILSCALE_AUTHKEY_FILE at the in-container path.
# TAILSCALE_AUTHKEY=tskey-auth-...
# TAILSCALE_AUTHKEY_FILE=/run/secrets/tailscale-authkey
# TAILSCALE_HOSTNAME=agent-workspace
# TAILSCALE_ADVERTISE_TAGS=tag:agent-workspace
# TAILSCALE_EXTRA_ARGS=
# TAILSCALE_SERVE=true
