[Desktop Entry]
Type=Application
Version=1.0
Name=Install Software Package
Name[zh_CN]=安装软件包
Comment=Install using persistent PRoot or native installation with startup restore
Comment[zh_CN]=选择 PRoot 持久化安装，或原生安装并在启动时恢复
Exec=/config/bin/agent-workspace-deb-installer %f
Icon=system-software-install
Terminal=false
StartupNotify=true
Categories=System;
MimeType=application/vnd.debian.binary-package;application/x-deb;
Keywords=deb;package;installer;software;
