{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "proxyctl": {
          "listen": [":80"],
          "routes": [
            {
              "@id": "proxyctl:not-ready",
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "body": "proxyctl is not initialized\n"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
