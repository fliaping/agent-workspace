#!/usr/bin/env bash
set -euo pipefail

if [[ -f /config/proxyctl/env ]]; then
  set -a
  . /config/proxyctl/env
  set +a
fi

: "${PROXY_ROOT_DOMAIN:=ping-dev.h1.fliaping.com}"
: "${CODE_SERVER_PROXY_DOMAIN:=$PROXY_ROOT_DOMAIN}"
: "${CODE_SERVER_BIND:=127.0.0.1:8443}"
: "${CODE_SERVER_WORKSPACE:=/config/Workspace}"

export HOME=/config
export USER=abc

mkdir -p "$CODE_SERVER_WORKSPACE"

exec /config/proxyctl/bin/code-server \
  --bind-addr "$CODE_SERVER_BIND" \
  --auth none \
  --disable-telemetry \
  --proxy-domain "$CODE_SERVER_PROXY_DOMAIN" \
  "$CODE_SERVER_WORKSPACE"
