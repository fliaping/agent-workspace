#!/bin/bash
set -uo pipefail
CONFIG_ROOT="${AGENT_WORKSPACE_CONFIG_ROOT:-/config}"
export AGENT_WORKSPACE_CONFIG_ROOT="$CONFIG_ROOT"
export HOME="$CONFIG_ROOT"
if [[ $(id -u) == 0 ]]; then
    exec s6-setuidgid abc /bin/bash "$0"
fi
mkdir -p "$CONFIG_ROOT/.local/log/agent-workspace"
exec >>"$CONFIG_ROOT/.local/log/agent-workspace/deb-native-restore.log" 2>&1
printf '\n[%s] Startup package restore\n' "$(date -u +%FT%TZ)"
"$CONFIG_ROOT/bin/agent-workspace-deb-native" restore --yes
result=$?
printf '[%s] Restore exit=%s; inspect agent-workspace-deb-native status\n' "$(date -u +%FT%TZ)" "$result"
# Run once per service start, including failures. Manual retry uses restore --yes.
exec s6-pause
