#!/usr/bin/env bash
set -euo pipefail

: "${CODE_SERVER_HOME:=/config/opt/code-server}"
: "${CODE_SERVER_CONFIG:=/config/.config/code-server/config.yaml}"
: "${CODE_SERVER_WORKSPACE:=/config/Workspace}"
: "${CODE_SERVER_RUNTIME_DIR:=/config/.local/run/code-server}"

export HOME=/config
export USER=abc
export XDG_RUNTIME_DIR="$CODE_SERVER_RUNTIME_DIR"

# A restart launched from an integrated terminal inherits editor IPC state.
# Keeping it makes the new process act as a client of the old editor instead
# of starting a server.
unset VSCODE_IPC_HOOK_CLI CODE_SERVER_PARENT_PID NODE_EXEC_PATH

mkdir -p "$CODE_SERVER_WORKSPACE" "$CODE_SERVER_RUNTIME_DIR"
chmod 700 "$CODE_SERVER_RUNTIME_DIR"

args=(--config "$CODE_SERVER_CONFIG" --disable-telemetry)
if [[ -n "${CODE_SERVER_PROXY_DOMAIN:-}" ]]; then
  args+=(--proxy-domain "$CODE_SERVER_PROXY_DOMAIN")
fi

exec "$CODE_SERVER_HOME/bin/code-server" "${args[@]}" "$CODE_SERVER_WORKSPACE"
