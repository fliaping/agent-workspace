#!/usr/bin/env python3
"""Native Debian installation with a persistent desired-package replay manifest."""
from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import time

base = runpy.run_path(str(Path(__file__).resolve().with_name('agent-workspace-deb')))
atomic_json, digest = base['atomic_json'], base['digest']


class NativeRuntime(base['Runtime']):
    label = 'Native'
    proot_mode = False
    desktop_prefix = 'agent-workspace-deb-native-'
    app_log_directory = 'deb-native-apps'

    def __init__(self):
        super().__init__()
        self.root = Path('/')
        self.state = self.config / '.local/share/agent-workspace/deb-native'
        self.manifest = self.state / 'packages.json'
        self.cache = self.config / '.cache/agent-workspace/deb-native'
        self.log = self.config / '.local/log/agent-workspace/deb-native.log'
        self.overrides = self.config / '.config/agent-workspace/deb-native-apps.json'
        self.command = self.config / 'bin/agent-workspace-deb-native'
        self.icons = self.config / '.local/share/icons/agent-workspace-deb-native'

    def require_ready(self):
        if not Path('/usr/bin/apt-get').is_file():
            raise RuntimeError('Native mode requires a Debian/Ubuntu host with apt-get.')

    @contextlib.contextmanager
    def lock(self):
        self.state.mkdir(parents=True, exist_ok=True)
        with (self.state / 'operation.lock').open('a') as handle:
            # Startup replay waits for an interactive installer instead of missing
            # the only restore attempt during this container start.
            fcntl.flock(handle, fcntl.LOCK_EX)
            yield

    def environment(self, install):
        env = super().environment(install)
        env.pop('PROOT_NO_SECCOMP', None)
        return env

    def invocation(self, argv, *, install=False, cwd=None, binds=()):
        if binds:
            raise RuntimeError('Native mode does not support PRoot bindings.')
        if install and argv[0] not in ('dpkg-query',) and os.geteuid() != 0:
            return ['sudo', '-n', 'env', 'DEBIAN_FRONTEND=noninteractive', *argv]
        return list(argv)

    @contextlib.contextmanager
    def open_bridge(self, env):
        yield

    def run(self, argv, cwd, package=None, desktop=False, dry_run=False):
        with contextlib.ExitStack() as stack:
            if cwd:
                stack.enter_context(contextlib.chdir(cwd))
            return super().run(argv, cwd, package, desktop, dry_run)

    def apt(self, args, *, binds=(), check=True):
        return self.execute(['apt-get', '-o', 'DPkg::Lock::Timeout=120',
                             '-o', 'APT::Sandbox::User=root',
                             '-o', 'Dpkg::Options::=--force-confold',
                             '-o', 'Acquire::Retries=3', *args], install=True, check=check)

    def install(self, package, simulate=False):
        self.require_ready()
        package = package.resolve(strict=True)
        details = self.metadata(package)
        if simulate:
            self.apt(['--simulate', '--no-remove', 'install', str(package)])
            return
        self.cache.mkdir(parents=True, exist_ok=True)
        checksum = digest(package)
        cached = self.cache / f'{details["name"]}-{checksum}.deb'
        if not cached.exists():
            temporary = cached.with_suffix('.partial')
            shutil.copyfile(package, temporary)
            if digest(temporary) != checksum:
                raise RuntimeError('Package changed while copying.')
            temporary.replace(cached)
        if digest(cached) != checksum:
            raise RuntimeError('Cached Debian package checksum mismatch.')
        state = self.load()
        previous = state['packages'].get(details['name'], {})
        state['packages'][details['name']] = {
            **previous, **details, 'desired_version': details['version'],
            'archive': str(cached), 'sha256': checksum, 'status': 'pending',
            'updated_at': int(time.time()),
        }
        atomic_json(self.manifest, state)
        self.restore()

    def verified_archive(self, record):
        archive = Path(record['archive']).resolve(strict=True)
        if not archive.is_relative_to(self.cache.resolve()) or archive.suffix != '.deb':
            raise RuntimeError('Replay archive must be inside the native package cache.')
        if digest(archive) != record['sha256']:
            raise RuntimeError(f'Cached Debian package checksum mismatch: {archive}')
        metadata = self.metadata(archive)
        if (metadata['name'] != record['name'] or metadata['arch'] != record['arch']
                or metadata['version'] != record['desired_version']):
            raise RuntimeError(f'Cached Debian package metadata mismatch: {archive}')
        return archive

    def restore(self):
        self.require_ready()
        status = {'started_at': int(time.time()), 'status': 'running', 'packages': []}
        atomic_json(self.state / 'restore-status.json', status)
        try:
            pending = []
            for name, record in self.load()['packages'].items():
                if not base['PACKAGE_RE'].fullmatch(name) or record.get('name') != name:
                    raise RuntimeError('Invalid package in native manifest.')
                archive = self.verified_archive(record)
                installed, version = self.installed(name)
                current = installed and subprocess.run(
                    ['dpkg', '--compare-versions', version, 'ge', record['desired_version']],
                    check=False).returncode == 0
                if not current:
                    pending.append(str(archive))
                    status['packages'].append(name)
            if pending:
                if self.apt(['update'], check=False).returncode:
                    print('Repository refresh failed; trying existing indexes and cached packages.', flush=True)
                self.apt(['install', '-y', '--no-remove', *pending])
            self.sync()
            for name in status['packages']:
                if not self.installed(name)[0]:
                    raise RuntimeError(f'Package is still not configured: {name}')
            status['status'] = 'restored' if pending else 'up-to-date'
            print(f'Native restore: {status["status"]}; {len(pending)} package(s).', flush=True)
        except BaseException as error:
            status.update(status='failed', error=str(error))
            raise
        finally:
            status['finished_at'] = int(time.time())
            atomic_json(self.state / 'restore-status.json', status)

    def remove(self, package, simulate=False):
        state = self.load()
        if package not in state['packages'] or not base['PACKAGE_RE'].fullmatch(package):
            raise RuntimeError('Specify a package managed by agent-workspace-deb-native list.')
        self.apt(['--simulate' if simulate else '-y', 'remove', package])
        if not simulate:
            self.sync()
            state = self.load()
            del state['packages'][package]
            atomic_json(self.manifest, state)
            print('Removed from native installation and startup replay; cached archive retained.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    for name in ('status', 'list', 'sync'):
        commands.add_parser(name)
    commands.add_parser('restore').add_argument('--yes', action='store_true')
    for name in ('install', 'remove'):
        cmd = commands.add_parser(name)
        cmd.add_argument('package')
        cmd.add_argument('--yes', action='store_true')
        cmd.add_argument('--dry-run', action='store_true')
    for name in ('launcher', 'launch'):
        commands.add_parser(name).add_argument('package')
    cmd = commands.add_parser('run')
    cmd.add_argument('--cwd')
    cmd.add_argument('--package')
    cmd.add_argument('--desktop', action='store_true')
    cmd.add_argument('--dry-run', action='store_true', help='Print effective launch arguments without starting the app')
    cmd.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    runtime = NativeRuntime()
    if args.action in ('status', 'list'):
        status_file = runtime.state / 'restore-status.json'
        print(json.dumps({'mode': 'native', **runtime.load(), 'restore':
              json.loads(status_file.read_text()) if status_file.exists() else None},
              ensure_ascii=False, indent=2))
        return 0
    if args.action == 'run':
        return runtime.run(args.command, args.cwd, args.package, args.desktop, args.dry_run)
    if args.action == 'launch':
        return runtime.launch(args.package)
    if args.action == 'launcher':
        print(runtime.primary_launcher(args.package))
        return 0
    if args.action in ('install', 'remove', 'restore'):
        if not args.yes and not getattr(args, 'dry_run', False):
            parser.error('Inspect the operation first; pass --yes to apply it.')
    with runtime.lock():
        if args.action == 'install':
            runtime.install(Path(args.package), args.dry_run)
        elif args.action == 'remove':
            runtime.remove(args.package, args.dry_run)
        elif args.action == 'restore':
            runtime.restore()
        else:
            runtime.sync()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.CalledProcessError) as error:
        print(f'Native Debian environment: {error}', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
