#!/usr/bin/env bash
set -euo pipefail

if [[ -f /config/proxyctl/env ]]; then
  set -a
  . /config/proxyctl/env
  set +a
fi

: "${CADDY_CONFIG:=/config/proxyctl/bootstrap.json}"
: "${XDG_CONFIG_HOME:=/config/proxyctl/caddy-config}"
: "${XDG_DATA_HOME:=/config/proxyctl/caddy-data}"

export XDG_CONFIG_HOME
export XDG_DATA_HOME

AUTOSAVE="$XDG_CONFIG_HOME/caddy/autosave.json"

if [[ -f "$AUTOSAVE" ]]; then
  exec /config/proxyctl/bin/caddy run --resume
fi

exec /config/proxyctl/bin/caddy run --config "$CADDY_CONFIG"
