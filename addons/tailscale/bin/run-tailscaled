#!/usr/bin/env bash
set -euo pipefail

: "${TAILSCALE_HOME:=/config/opt/tailscale}"
: "${TAILSCALE_STATE_DIR:=/config/.local/share/tailscale}"
: "${TAILSCALE_RUNTIME_DIR:=/config/.local/run/tailscale}"
: "${TAILSCALE_PROXY_LISTEN:=127.0.0.1:1055}"

export HOME=/config
export USER=abc

mkdir -p "$TAILSCALE_STATE_DIR" "$TAILSCALE_RUNTIME_DIR"
chmod 700 "$TAILSCALE_STATE_DIR" "$TAILSCALE_RUNTIME_DIR"

socket="$TAILSCALE_RUNTIME_DIR/tailscaled.sock"
if [[ -S "$socket" ]]; then
  rm -f -- "$socket"
fi

exec "$TAILSCALE_HOME/libexec/tailscaled" \
  --state="$TAILSCALE_STATE_DIR/tailscaled.state" \
  --socket="$socket" \
  --tun=userspace-networking \
  --socks5-server="$TAILSCALE_PROXY_LISTEN" \
  --outbound-http-proxy-listen="$TAILSCALE_PROXY_LISTEN"
