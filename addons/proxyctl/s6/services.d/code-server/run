#!/usr/bin/with-contenv bash
set -euo pipefail

if [[ -f /config/proxyctl/env ]]; then
  set -a
  . /config/proxyctl/env
  set +a
fi

: "${PROXY_ROOT_DOMAIN:=ping-dev.h1.fliaping.com}"
: "${CODE_SERVER_BIND:=127.0.0.1:8443}"
: "${CODE_SERVER_WORKSPACE:=/config/Workspace}"
: "${CODE_SERVER_PASSWORD_FILE:=/config/proxyctl/code-server-password}"

if [[ ! -f "$CODE_SERVER_PASSWORD_FILE" ]]; then
  mkdir -p "$(dirname "$CODE_SERVER_PASSWORD_FILE")"
  umask 077
  tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32 > "$CODE_SERVER_PASSWORD_FILE"
  echo >> "$CODE_SERVER_PASSWORD_FILE"
fi

export HOME=/config
export USER=abc
export PASSWORD
PASSWORD="$(tr -d '\r\n' < "$CODE_SERVER_PASSWORD_FILE")"

mkdir -p "$CODE_SERVER_WORKSPACE"
chown -R abc:abc /config/.config /config/.local "$CODE_SERVER_WORKSPACE" 2>/dev/null || true

exec s6-setuidgid abc code-server \
  --bind-addr "$CODE_SERVER_BIND" \
  --auth password \
  --disable-telemetry \
  --proxy-domain "$PROXY_ROOT_DOMAIN" \
  "$CODE_SERVER_WORKSPACE"
